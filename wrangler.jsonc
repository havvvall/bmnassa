// Cloudflare: serve the built site (dist) as static files.
// Unknown paths fall back to index.html so the app's own pages (/signin, /account…) work on refresh.
{
  "name": "bmnassa",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
